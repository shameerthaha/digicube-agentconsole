# Optional. Without a key the demo runs on deterministic canned outputs
# (marked LLM FALLBACK in the top bar). With a key, classification,
# extraction and drafting are done by Claude live.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# 'live' calls Claude (default). 'replay' serves seed/live-cache.json
# captured by `npm run capture` - zero API spend, use for public deploys.
AGENT_LLM_MODE=
# Hard cap on live calls per server instance (default 60). 0 = no live calls.
AGENT_LLM_BUDGET=
